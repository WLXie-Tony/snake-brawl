{
  "name": "snake-brawl-app",
  "version": "1.0.0",
  "private": true,
  "description": "蛇蛇乱斗 for the App Store and Google Play: the web game wrapped with Capacitor",
  "scripts": {
    "game": "node scripts/copy-game.mjs && node scripts/configure.mjs",
    "sync": "node scripts/copy-game.mjs && node scripts/configure.mjs && node scripts/build-native.mjs && cap sync",
    "icons": "capacitor-assets generate --ios --android --iconBackgroundColor \"#0e1b3d\" --iconBackgroundColorDark \"#0e1b3d\" --splashBackgroundColor \"#e9eff9\" --splashBackgroundColorDark \"#e9eff9\"",
    "rename": "node scripts/rename.mjs",
    "ios-setup": "node scripts/ios-setup.cjs",
    "configure": "node scripts/configure.mjs",
    "native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^14.1.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "esbuild": "^0.25.12"
  }
}
